# Application
APP_NAME="General Agent Platform"
APP_VERSION="2.0.0"
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (MySQL)
# 端口说明：本地 MySQL 用 3306；Docker Compose 的 MySQL 映射到宿主机 127.0.0.1:3308
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3308/ai_plat
DATABASE_SYNC_URL=mysql+pymysql://root:123456@localhost:3308/ai_plat

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100

# 本地启动后端时，配置可访问的私有 ASR 地址并安装 FFmpeg。
ASR_BASE_URL=
ASR_MODEL=sensevoice
ASR_TIMEOUT_SECONDS=60
ASR_MAX_UPLOAD_MB=10
ASR_MAX_AUDIO_SECONDS=60

# Default Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_USERNAME=admin

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Agent 执行引擎 ──────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
AGENT_MAX_TOOL_RETRIES=2
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MCP_TIMEOUT_SECONDS=30       # MCP 单次工具调用/发现超时
AGENT_MAX_SAME_TOOL_CALLS=3     # 同工具同参重复防护阈值（新旧引擎共用，0=不防护）
AGENT_TEMPERATURE=0.3
AGENT_ENABLE_SELF_VERIFY=true
AGENT_ENABLE_SOURCE_CITATION=true

# ── 推理层（30B 模型优化）────────────────────────────────────────────────────
INFERENCE_MAX_CONTEXT_TOKENS=8192
INFERENCE_MAX_OUTPUT_TOKENS=4096
INFERENCE_KV_CACHE_MAX_MB=4096
INFERENCE_CONCURRENT_REQUESTS=2
INFERENCE_REQUEST_QUEUE_SIZE=20
INFERENCE_REQUEST_TIMEOUT=120

# ── 上下文管理 ──────────────────────────────────────────────────────────────
CONTEXT_SLIDING_WINDOW_TURNS=6
CONTEXT_MAX_HISTORY_TOKENS=2048
CONTEXT_SUMMARY_THRESHOLD=4096
CONTEXT_PIN_SYSTEM_PROMPT=true
CONTEXT_PIN_ORIGINAL_TASK=true

# ── 记忆系统 ────────────────────────────────────────────────────────────────
MEMORY_SHORT_TERM_MAX_TURNS=6
MEMORY_LONG_TERM_MAX_ITEMS=200
MEMORY_IMPORTANCE_THRESHOLD=0.5
MEMORY_AUTO_DISTILL=true
MEMORY_STRUCTURED_STORE=true
MEMORY_CONFLICT_STRATEGY=newer
MEMORY_DB_PATH=./data/memory

# ── 幻觉抑制 ────────────────────────────────────────────────────────────────
HALLUCINATION_FACT_CHECK=true
HALLUCINATION_MAX_VERIFY_ROUNDS=2
HALLUCINATION_FORCE_SOURCE=true
HALLUCINATION_UNCERTAINTY_EXPR=true

# ── 监控与日志 ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_AGENT_TRACE=true
LOG_TOOL_CALLS=true
LOG_PERFORMANCE=true
MONITOR_ENABLE=true
MONITOR_SLOW_THRESHOLD_MS=5000

# ── 搜索引擎（内网环境）────────────────────────────────────────────────────
SEARXNG_URL=                          # SearXNG 实例地址，如 http://localhost:8888（留空则使用外网引擎）
SEARCH_TIMEOUT=25                     # 搜索超时秒数

# ── 稳定性 ──────────────────────────────────────────────────────────────────
HOT_RELOAD_TOOLS=true
HOT_RELOAD_PROMPTS=true
SESSION_ISOLATION=true
DETERMINISTIC_MODE=false

# 工程运行验收由独立容器处理。独立启动后端时可配置与验收容器共享的队列目录。
AGENT_PROJECT_VERIFIER_DIR=
CHECKPOINT_ENABLED=true
CHECKPOINT_DIR=./data/checkpoints

# ── Durable Execution（Phase 2.1）───────────────────────────────────────────
# 运行环境：development | staging | production
# production 时禁止 AGENT_CHECKPOINT_DSN=memory（启动即拒绝）
APP_ENV=development
# Checkpointer 后端（三选一）：
#   memory                       仅开发/单测，不支持多进程共享与重启恢复
#   sqlite:///./data/agent_checkpoints.db    单进程持久化（多进程共享 SQLite 不被支持）
#   postgresql://user:pass@host:5432/db      生产 / Docker 多 Worker 共享
# 注意：使用 psycopg 直连，DSN 写 postgresql://...，不要带 +asyncpg 等 SQLAlchemy 驱动标记
AGENT_CHECKPOINT_DSN=sqlite:///./data/agent_checkpoints.db
# 跨线程记忆 Store（可选，空=不启用；支持 memory / postgresql://...）
AGENT_STORE_DSN=
# Worker 租约协调（多 Worker 执行权）
# AGENT_RUNTIME_WORKER_ID=          # 空=自动生成 hostname-pid-随机
AGENT_RUNTIME_LEASE_SECONDS=60
AGENT_RUNTIME_HEARTBEAT_INTERVAL=15.0
AGENT_RUNTIME_POLL_INTERVAL=1.0
# SSE 事件下发轮询兜底间隔（同进程由事件唤醒立即推送，越小越实时）
AGENT_SSE_POLL_INTERVAL=0.3
# 模型文本增量落库时间上限（秒）：SSE 只读 DB，增量按此间隔流出（兼顾事务批量）
AGENT_DELTA_FLUSH_INTERVAL=0.2
AGENT_RUNTIME_SHUTDOWN_GRACE=30.0
# 执行预算（Durable Runtime；0=不限制，墙钟超时始终生效）
AGENT_MAX_STEPS=1000
AGENT_MAX_TOOL_CALLS=1000
AGENT_MAX_MODEL_CALLS=1000
AGENT_RUN_TIMEOUT=0
AGENT_VERIFICATION_MAX_ROUNDS=2  # 长任务在原运行预算内补齐验收缺口的次数
# 模型驱动的意图识别（会话有历史/附件/预览文档时启用；失败自动回退规则路由）
AGENT_INTENT_ROUTER_ENABLED=true
AGENT_INTENT_ROUTER_TIMEOUT=8  # 秒，超时回退规则路由，不阻塞建 Run
AGENT_INTENT_ROUTER_MAX_TOKENS=320
