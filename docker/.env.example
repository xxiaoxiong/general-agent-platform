# P0-04 部署安全：复制为 docker/.env 并填入真实值。缺失必填变量时 docker compose 直接报错。
# 生成随机密钥：openssl rand -hex 32

# ── 必填：数据库与凭据 ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
SECRET_KEY=
# 首次登录后立即修改；生产环境弱口令会被启动校验拒绝（>=12 位）
ADMIN_PASSWORD=
# SearXNG（内网搜索）实例密钥，随机生成：openssl rand -hex 32
SEARXNG_SECRET=

# ── 可选：带默认值 ─────────────────────────────────────────────────────────
#MYSQL_DATABASE=ai_plat
#MYSQL_USER=ai_plat
#POSTGRES_USER=ai_cp
#POSTGRES_DB=agent_checkpoints
#ADMIN_EMAIL=admin@example.com
#ADMIN_USERNAME=admin
#APP_ENV=production
#CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
#PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ── 智能体每次运行的预算 ────────────────────────────────────────────────
#AGENT_MAX_STEPS=1000
#AGENT_MAX_MODEL_CALLS=1000
#AGENT_MAX_TOOL_CALLS=1000
#AGENT_RUN_TIMEOUT=0
# 模型驱动的语义决策（Decision Architecture）：off / shadow / llm
#AGENT_DECISION_MODE=llm
#AGENT_DECISION_TIMEOUT=15
#AGENT_DECISION_MAX_TOKENS=600
#AGENT_AUTO_TEAM_ENABLED=false

# ── Agent 测评（Evaluation Worker / Campaign）─────────────────────────────
#EVALUATION_WORKER_ENABLED=true
#EVALUATION_POLL_INTERVAL=5.0
#EVALUATION_WORKER_BATCH=2
#EVALUATION_LEASE_SECONDS=120
#EVALUATION_HEARTBEAT_INTERVAL=20.0
#EVALUATION_INFRA_RETRY_MAX=1
# 独立 Judge 模型（0=回退 EVOLUTION_JUDGE_MODEL_CONFIG_ID）
#EVALUATION_JUDGE_MODEL_CONFIG_ID=0

# ── 离线工程运行验收 ───────────────────────────────────────────────────────
# 默认使用 Compose 内的专用离线验收容器。显式留空时，工程只执行静态检查。
#AGENT_PROJECT_VERIFIER_DIR=/var/lib/project-verifier

# ── Workspace Sandbox（项目级持久化开发工作空间）────────────────────────────
# 启用步骤：
#   1) 构建 Sandbox 镜像：docker compose --profile sandbox-image build
#   2) 本文件设置 SANDBOX_ENABLED=true、AGENT_SANDBOX_MODE=external、SANDBOX_RUNNER_TOKEN
#   3) 启动：docker compose --profile sandbox up -d
# 内部服务令牌（>=16 位，Backend / Runner / Preview Proxy 共用）：openssl rand -hex 32
#SANDBOX_ENABLED=true
#SANDBOX_RUNNER_TOKEN=
#AGENT_SANDBOX_MODE=external
# 灰度白名单（逗号分隔；为空=全部用户/项目）
#SANDBOX_ROLLOUT_USER_IDS=
#SANDBOX_ROLLOUT_PROJECT_IDS=
#SANDBOX_DEFAULT_PROFILE=standard
#SANDBOX_MAX_ACTIVE_PER_USER=2
#SANDBOX_MAX_ACTIVE_PER_TENANT=20
# 空闲回收秒数（0=不自动停止；停止只释放 CPU/内存，Volume 保留）
#SANDBOX_IDLE_TIMEOUT=1800
# egress=允许公网下载依赖；none=完全断网
#SANDBOX_NETWORK_POLICY=egress
# 每个 Sandbox 独立 bridge 网络。并发项目较多时配置专用子网池，避免 Docker
# 默认地址池（约十几个 /16）耗尽后报 "all predefined address pools have been fully subnetted"。
#SANDBOX_NETWORK_SUBNET_POOL=10.210.0.0/16
#SANDBOX_NETWORK_SUBNET_PREFIX=24
# soft=磁盘软配额（监控预警，超限停止 Sandbox）；hard=宿主文件系统支持时启用硬配额
#SANDBOX_VOLUME_QUOTA_MODE=soft
# 软配额预警阈值（%）：达到后发布 sandbox.volume_quota_warning
#SANDBOX_VOLUME_QUOTA_WARN_PERCENT=85
# 宿主机为 OS/平台保留的资源（Runner 可分配 = 总量 - 保留）
#SANDBOX_CPU_RESERVE=2
#SANDBOX_MEMORY_RESERVE=2048
#SANDBOX_DISK_RESERVE=20
#SANDBOX_RUNNER_DISK_GB=100
# 本地预览：{token}.localhost:8081；生产必须设置独立 https 域名
#PREVIEW_BASE_DOMAIN=localhost
#PREVIEW_PUBLIC_BASE_URL=
#PREVIEW_PROXY_HOST_PORT=8081
#PREVIEW_TOKEN_TTL=3600
#PREVIEW_MAX_CONNECTIONS=16
# 单个 Preview Grant 每分钟请求上限（0=不限）
#PREVIEW_RATE_LIMIT_PER_MINUTE=600
# true=仅登录用户可访问预览（禁止外部分享，未登录请求 403）
#PREVIEW_REQUIRE_LOGIN=false
# 内置浏览器（服务端 Chromium）：平台侧打开页面，客户机无需访问 Preview 端口
# 内部服务令牌（>=16 位，Backend / browser-service 共用）：openssl rand -hex 32
#BROWSER_SERVICE_TOKEN=
# 服务端浏览器访问 Preview Proxy 的内部域名（仅容器网络内使用）
#PREVIEW_INTERNAL_BASE_DOMAIN=preview.internal
#BROWSER_MAX_SESSIONS=4
#BROWSER_SESSION_TTL=1800
#BROWSER_SESSION_IDLE_TIMEOUT=120
#BROWSER_FRAME_QUALITY=60
#BROWSER_FRAME_INTERVAL_MS=70

# ── 本地语音听写（可选）────────────────────────────────────────────────────
# 主 Compose 项目内的服务地址，显式留空可停用听写入口。
#ASR_BASE_URL=http://asr:8000
#ASR_MODEL=sensevoice
#ASR_TIMEOUT_SECONDS=60
#ASR_MAX_UPLOAD_MB=10
#ASR_MAX_AUDIO_SECONDS=60

# ── SearXNG 内网搜索（web_search 工具）──────────────────────────────────
# Backend 访问 SearXNG 的地址与搜索超时秒数（默认即可，一般无需修改）
#SEARXNG_URL=http://searxng:8080
#SEARCH_TIMEOUT=25
# 提示词"当前时间"时区（容器通常为 UTC，避免北京时间凌晨日期差一天）
#AGENT_TIMEZONE=Asia/Shanghai

# ── Langfuse 可观测（可选）─────────────────────────────────────────────────
# 在 Langfuse UI 中为项目生成 pk-lf-/sk-lf- 密钥填入；留空则不上报 Trace。
# 需要 langfuse-deploy 栈的 docker 网络存在（compose 以 external 网络挂接）。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 容器内访问地址 / 浏览器跳转地址（默认值适用于宿主机 langfuse-deploy 栈）
#LANGFUSE_BASE_URL=http://langfuse-deploy-langfuse-web-1:3000
#LANGFUSE_PUBLIC_URL=http://localhost:3100
# Trace 页面路由需要的项目 ID（/project/{id}/traces/...）；留空则启动后自动发现
#LANGFUSE_PROJECT_ID=
