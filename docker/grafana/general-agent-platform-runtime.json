{
  "title": "General Agent Platform Agent Runtime",
  "uid": "general-agent-platform-runtime",
  "tags": ["general-agent-platform", "agent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run 总览（状态分布）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (status) (rate(agent_runs_total[5m]))", "legendFormat": "{{status}}" },
        { "expr": "agent_active_runs", "legendFormat": "active" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "模型性能（延迟 P50/P95）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, model) (rate(agent_model_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agent_model_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{model}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "工具成功率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (tool, status) (rate(agent_tool_calls_total[5m]))", "legendFormat": "{{tool}} {{status}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(agent_tool_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{tool}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker / 队列（排队等待与活跃 Run）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_queue_wait_seconds_bucket[5m])))", "legendFormat": "queue wait p95" },
        { "expr": "agent_active_runs", "legendFormat": "active runs" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "错误恢复（重试 / 恢复决策 / 执行权丢失）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (reason) (rate(agent_run_retries_total[5m]))", "legendFormat": "retry {{reason}}" },
        { "expr": "sum by (decision) (rate(agent_recovery_total[5m]))", "legendFormat": "recovery {{decision}}" },
        { "expr": "rate(agent_lease_lost_total[5m])", "legendFormat": "lease lost" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token / 成本",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum by (model, direction) (rate(agent_tokens_total[5m]))", "legendFormat": "{{model}} {{direction}}" },
        { "expr": "sum by (provider, model) (rate(agent_model_calls_total[5m]))", "legendFormat": "calls {{model}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB / Checkpoint（写入延迟）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_checkpoint_write_seconds_bucket[5m])))", "legendFormat": "checkpoint p95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(agent_checkpoint_write_seconds_bucket[5m])))", "legendFormat": "checkpoint p50" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "事件流与 SSE（滞后 / 断线重连）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_event_lag_seconds_bucket[5m])))", "legendFormat": "event lag p95" },
        { "expr": "rate(agent_sse_reconnect_total[5m])", "legendFormat": "sse reconnect" }
      ]
    }
  ]
}
